# Railway fills DATABASE_URL when you add Postgres and reference it.
DATABASE_URL=postgresql://user:pass@host:5432/railway
# Your live site address, no trailing slash
BASE_URL=https://riverfrontretreatrvpark.com
# Stripe: Developers > API keys (use sk_test_... first, then sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe: Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Password for riverfrontretreatrvpark.com/admin (any username works)
ADMIN_PASSWORD=choose-a-long-password
